rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.sypRole in ['admin', 'editor', 'viewer'];
    }
    function writer() {
      return member() && request.auth.token.sypRole in ['admin', 'editor'];
    }
    function admin() {
      return member() && request.auth.token.sypRole == 'admin';
    }
    match /{collectionId}/{documentId} {
      function operationalCollection() {
        return collectionId in ['meydanlar', 'vardiyalar', 'kronikSorunlar',
          'personelIzinler', 'meydanBasvurulari', 'meydanBasvuruStats',
          'personelBasvuruOzetleri', 'meydanFaaliyetRaporlari', 'operasyonelIcgoruler',
          'vardiyaYuklemeLoglari'];
      }
      allow read: if operationalCollection() && member();
      allow create, update: if operationalCollection() && writer();
      allow delete: if operationalCollection() && admin();
    }
    match /meydanlar/{meydanId}/gunlukNotlar/{noteId} {
      allow read: if member();
      allow create, update: if writer();
      allow delete: if admin();
    }
    match /meydanFaaliyetRaporlari/{reportId}/chunks/{chunkId} {
      allow read: if member();
      allow create, update: if writer();
      allow delete: if admin();
    }
  }
}
