rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.sypRole in ['admin', 'editor', 'viewer'];
    }
    match /faaliyet-raporlari/{allPaths=**} {
      allow read: if member();
      allow create, update: if member() && request.auth.token.sypRole in ['admin', 'editor'];
      allow delete: if member() && request.auth.token.sypRole == 'admin';
    }
  }
}
